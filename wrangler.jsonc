{
  // نام باید دقیقاً با نام Worker در داشبورد Cloudflare یکی باشد
  "name": "nedakhanifar-com",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // درخواست‌های API قبل از فایل‌های استاتیک به Worker می‌رسند
    "run_worker_first": ["/api/*"]
  },
  // متغیرها و Secretهای ثبت‌شده در داشبورد با هر deploy پاک نشوند
  "keep_vars": true,
  // ارسال ایمیل فرم تماس (Cloudflare Email Routing). گیرنده ثابت = ایمیل مالک سایت
  "send_email": [{ "name": "EMAIL", "destination_address": "khanifarnda@gmail.com" }],
  "observability": { "enabled": true }
}
